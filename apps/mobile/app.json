{
  "expo": {
    "name": "Soru Atölyesi",
    "slug": "soru-atolyesi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "soruatolyesi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.soruatolyesi.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.soruatolyesi.app",
      "adaptiveIcon": {
        "backgroundColor": "#2679E7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2679E7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "@clerk/expo",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#2679E7"
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-web-browser"
    ],
    "updates": {
      "url": "https://u.expo.dev/828bc4d0-0368-47fa-ae1b-017cc3ed5b72"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "828bc4d0-0368-47fa-ae1b-017cc3ed5b72"
      }
    },
    "owner": "ardakrts"
  }
}

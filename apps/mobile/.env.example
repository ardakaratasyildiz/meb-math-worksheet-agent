# apps/mobile ortam değişkenleri — bu dosyayı `.env` olarak kopyalayıp doldurun.
# EXPO_PUBLIC_* değişkenleri istemci bundle'ına gömülür (public — sır KOYMAYIN).

# Clerk (web ile AYNI instance — publishable key). Vercel/Clerk panosundan pk_...
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Backend API. Canlı: https://api.soruatolyesi.com · Lokal: http://localhost:8000
EXPO_PUBLIC_API_URL=https://api.soruatolyesi.com

# Backend public API key — web'deki NEXT_PUBLIC_API_KEY ile AYNI değer.
EXPO_PUBLIC_API_KEY=

# apps/mobile ortam değişkenleri — bu dosyayı `.env` olarak kopyalayıp doldurun.
# EXPO_PUBLIC_* değişkenleri istemci bundle'ına gömülür (public — sır KOYMAYIN).
#
# BU DOSYA yalnız YEREL geliştirme (Metro / dev-client) içindir. EAS sunucusunda
# derlenen preview/production build'ler .env'i GÖRMEZ; onların değerleri EAS
# environment variables'tan gelir (eas.json'daki "environment" alanı seçer).
# Kurulum komutları: docs/MOBIL_STORE_HAZIRLIK.md §1.

# Clerk (web ile AYNI instance — publishable key). Vercel/Clerk panosundan pk_...
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Backend API. Canlı: https://api.soruatolyesi.com · Lokal: http://localhost:8000
EXPO_PUBLIC_API_URL=https://api.soruatolyesi.com

# Backend public API key — web'deki NEXT_PUBLIC_API_KEY ile AYNI değer.
EXPO_PUBLIC_API_KEY=

# RevenueCat PUBLIC SDK anahtarları (RevenueCat panosu → Project → API keys).
# iOS anahtarı appl_..., Android anahtarı goog_... ile başlar. Secret key ASLA buraya.
# Boş bırakılırsa satın-alma devre dışı kalır (paywall "mağaza sürümü gerekir" der).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Backend API (FastAPI). Lokal: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend API key — app/security.py'deki API_KEYS env'inden bir tanesi
# (boşsa auth devre dışı; production'da MUTLAKA set edilmeli)
NEXT_PUBLIC_API_KEY=

# Clerk auth (sign-up'tan al: https://clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/generate
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/generate

# ─── Admin paneli (Yaklaşım A: server-side proxy) ───────────────────────────
# Bu üç değişken SERVER-ONLY — NEXT_PUBLIC_ prefix YOK. Vercel'de set ederken
# "Environments" sekmesinde sadece Production seçili olsun; Preview'larda
# açılmasını istemiyorsan flag'i false bırak.

# Backend admin endpoint'leri için API key. Render'daki ADMIN_API_KEY ile
# birebir aynı değer. Boşsa proxy 500 döner.
ADMIN_API_KEY=

# Backend base URL (server-side). NEXT_PUBLIC_API_URL'den ayrı tutulur ki
# server proxy iç ağ üzerinden farklı bir host'a gidebilsin. Boşsa
# NEXT_PUBLIC_API_URL'e düşer.
BACKEND_URL=https://api.soruatolyesi.com

# Admin paneli feature flag — "true" değilse /admin/* ve /api/admin/* 404 döner.
# Preview/dev deploy'larda kazara açılmasını engeller. Production'da "true" yap.
ADMIN_ENABLED=false

# ─── SEO + Analytics ────────────────────────────────────────────────────────

# Site canonical URL. Vercel preview deploy'larda otomatik VERCEL_URL'e düşer.
# Production'da soruatolyesi.com kalır.
NEXT_PUBLIC_SITE_URL=https://soruatolyesi.com

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Boşsa Analytics yüklenmez.
# Kullanıcı cookie banner'da "Kabul et" demeden hiçbir GA script enjekte edilmez
# (KVKK uyumu) — bu key set olsa bile.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console doğrulama token'ı (HTML meta yöntemi). SC'de "URL prefix"
# property açıp HTML tag doğrulamasını seçince verilen content değeri. Boşsa meta
# basılmaz (DNS TXT yöntemiyle de doğrulanabilir). Sadece content kısmını gir.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
